FROM node:22-bookworm-slim AS web
WORKDIR /app/frontend
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_API_BASE_URL
RUN test -n "$VITE_API_BASE_URL" && npm run typecheck && node ./node_modules/vite/bin/vite.js build

FROM maven:3.9.9-eclipse-temurin-21 AS backend
WORKDIR /app/backend
COPY backend/pom.xml ./
RUN mvn -B dependency:go-offline
COPY backend/src ./src
COPY --from=web /app/frontend/dist ./src/main/resources/static
RUN mvn -B -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=backend /app/backend/target/auction-backend-0.1.0.jar app.jar
COPY deploy/render/start.sh /app/start.sh
EXPOSE 10000
ENTRYPOINT ["/bin/sh", "/app/start.sh"]
